# Copy to .env for local development. Never commit .env or real credentials.
SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=0

# Local SQLite is fine for development. Use managed PostgreSQL for deployment.
DATABASE_URI=sqlite:///traveltech.db

# Safe default: no email is sent in test mode.
SMTP_TEST_MODE=True
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DEFAULT_SENDER=

DEFAULT_PROXIMITY_RADIUS_METERS=50
LOCATION_HISTORY_RETENTION_MINUTES=10
